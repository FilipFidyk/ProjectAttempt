<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Design.PreviewWith>
    <Border Background="#F5F5F5" Padding="20">
      <ContentControl ContentTemplate="{DynamicResource AndGateTemplate}" />
    </Border>
  </Design.PreviewWith>

  <DataTemplate x:Key="AndGateTemplate">
    <Canvas Width="80" Height="60">
      <Path Fill="White"
            Stroke="{DynamicResource CircuitStrokeBrush}"
            StrokeThickness="{DynamicResource CircuitStrokeThickness}">
        <Path.Data>
          <PathGeometry>
            <PathFigure StartPoint="20,10" IsClosed="True">
              <LineSegment Point="40,10" />
              <ArcSegment Point="40,50"
                          Size="20,20"
                          RotationAngle="0"
                          IsLargeArc="False"
                          SweepDirection="Clockwise" />
              <LineSegment Point="20,50" />
            </PathFigure>
          </PathGeometry>
        </Path.Data>
      </Path>

      <Line StartPoint="0,20" EndPoint="20,20"
            Stroke="{DynamicResource CircuitStrokeBrush}"
            StrokeThickness="{DynamicResource CircuitStrokeThickness}" />
      <Line StartPoint="0,40" EndPoint="20,40"
            Stroke="{DynamicResource CircuitStrokeBrush}"
            StrokeThickness="{DynamicResource CircuitStrokeThickness}" />
      <Line StartPoint="60,30" EndPoint="80,30"
            Stroke="{DynamicResource CircuitStrokeBrush}"
            StrokeThickness="{DynamicResource CircuitStrokeThickness}" />
    </Canvas>
  </DataTemplate>

</ResourceDictionary>
